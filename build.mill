//| mill-version: 1.0.6
//| mill-jvm-version: temurin:24
//| mill-jvm-opts: ["--enable-native-access=ALL-UNNAMED"]
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0
package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*, scalalib.*
import mill.api.Task.Simple

trait ForjaModule extends ScalaModule, ScalafixModule:
  def scalaVersion = "3.7.3"
  def scalacOptions = Seq(
    "-Werror",
    "-Wunused:strict-no-implicit-warn",
    "-Yexplicit-nulls",
    "-deprecation",
    "-feature",
    "-source:future",
    "-Xcheck-macros",
    "-explain-cyclic",
  )
  override def forkArgs = super.forkArgs() ++ Seq(
    // TODO: fix when Scala 3.8?
    "--sun-misc-unsafe-memory-access=allow",
  )

  trait ForjaTests extends ScalaTests:
    def mvnDeps = Seq(
      mvn"com.lihaoyi::utest:0.9.1",
    )
    def testFramework = "utest.runner.Framework"
    override def forkArgs = super.forkArgs() ++ Seq(
      "--sun-misc-unsafe-memory-access=allow",
      // "-agentlib:jdwp=transport=dt_socket,server=y,address=5005,suspend=y",
    )
  end ForjaTests
end ForjaModule

object forja extends ForjaModule:
  override def mvnDeps = Seq(
    mvn"com.lihaoyi::sourcecode:0.4.4",
    mvn"com.lihaoyi::os-lib:0.11.5",
    mvn"org.typelevel::cats-core:2.13.0",
  )
  object test extends ForjaTests
end forja
